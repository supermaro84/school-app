# Copy to .env and fill in for each deployment. Restart the app after changes.

# --- File storage (DigitalOcean Spaces / S3) -------------------------------
ACCESS_KEY=
SECRET_KEY=
BUCKET_NAME=

# --- Theme ------------------------------------------------------------------
# All theme settings are optional; leave a line empty to use the default.

# Name shown in the navbar, page titles and footer.
# Default: "School App", translated into the user's language.
APP_NAME=

# Ready-made palette: default | ocean | forest | sunset | plum
THEME_PRESET=default

# Override the preset's colours with hex values, e.g. #2563eb or #26e.
THEME_PRIMARY_COLOR=
THEME_SECONDARY_COLOR=

# Font for all text: system (the device's own font, default) or a Google Fonts
# family name, e.g. Inter, Roboto, Open Sans, Lato, Nunito, Poppins.
# Loaded from fonts.googleapis.com (visitors' browsers contact Google).
THEME_FONT=system
# Optional font for headings and the app name; defaults to THEME_FONT.
THEME_HEADING_FONT=

# Navbar background: dark | light | primary (uses the primary colour)
THEME_NAVBAR=dark

# Default colour mode: auto (follows the device) | light | dark.
# Each viewer can still switch with the theme toggle; their choice is saved
# in their browser.
THEME_MODE=auto

# Logo shown next to the app name, and the browser tab icon (any URL,
# e.g. /static/img/logo.png or https://...). Default: a graduation cap.
THEME_LOGO_URL=
THEME_FAVICON_URL=

# Replaces the default "© <year> <app name>. All rights reserved." footer.
THEME_FOOTER_TEXT=
